{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "happy",
  "main": "worker.js",
  "compatibility_date": "2026-08-14",

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },

  "observability": {
    "enabled": true
  }
}
